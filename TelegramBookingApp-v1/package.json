{
  "name": "bookingapp-telegram-mini-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute booking-app-db --remote --file=schema.sql",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/worker.test.js tests/domain.test.js tests/sync.test.js tests/fullscreen.test.js",
    "check": "node --check public/app.js && node --check public/domain.js && node --check public/sync.js && node --check public/fullscreen.js && node --check src/worker.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
